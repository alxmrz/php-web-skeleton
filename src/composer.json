{
    "name": "skeleton/app",
    "description": "PHP web skeleton: console tic-tac-toe demo",
    "type": "project",
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "cli/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "cli/tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
